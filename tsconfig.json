{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@images": ["./src/assets/images"],
      "@icons": ["./src/assets/icons"],
      "@components/*": ["./src/components/*"],
      "@constants/*": ["./src/constants/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@navigations": ["./src/navigations"],
      "@scenes/*": ["./src/scenes/*"],
      "@utils/*": ["./src/utils/*"],
      "@colors": ["./src/styles/colors"],
      "@redux/*": ["./src/redux/*"],
      "@libs/*": ["./src/libs/*"]
    }
  }
}